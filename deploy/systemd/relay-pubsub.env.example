# Gateway listeners — TLS-only (HTTPS/gRPCS), no plaintext mode.
# Lab/host default avoids :8080 collisions — use 8081 / 50061.
PUBSUB_GRPC_ADDR=0.0.0.0:50061
PUBSUB_HTTP_ADDR=0.0.0.0:8081

# Self-signed cert/key, generated once on first start and reused after (the
# gateway terminates TLS itself — no reverse proxy needed). Override the
# paths to supply your own CA-signed cert instead. PUBSUB_TLS_SAN only
# affects the *generated* cert — set it to this host's real name/IP before
# first start if clients will validate the cert's name rather than skip
# verification (e.g. curl -k / grpcurl -insecure).
PUBSUB_TLS_CERT=/var/lib/relay-pubsub/tls/cert.pem
PUBSUB_TLS_KEY=/var/lib/relay-pubsub/tls/key.pem
PUBSUB_TLS_SAN=localhost,127.0.0.1,relay-pubsub

# memory = self-contained demo; http = invented topics/subscriptions contract
# (docs/relay-native-api.md); relay-events = Relay's real API (see
# docs/RELAY_EVENTS_BACKEND.md) — use this one for the Fasal integration.
RELAY_BACKEND=memory
RELAY_BASE_URL=http://relay:9090
RELAY_AUTH_TOKEN=
RELAY_HTTP_TIMEOUT_SECONDS=15

# Only used by RELAY_BACKEND=relay-events
FASAL_GCP_PROJECT=fasal-onprem
FASAL_ACTIONS_TOPIC=farm-actions
FASAL_ACTIONS_SUBSCRIPTION=farm-actions-sub

# Skip TLS verify on outbound calls to RELAY_BASE_URL (self-signed Relay)
RELAY_TLS_INSECURE=1

# Optional compatibility-gateway bearer token. Leave empty for Pub/Sub emulator clients.
RELAY_PUBSUB_AUTH_TOKEN=
RUST_LOG=info
