# Gateway listeners
PUBSUB_GRPC_ADDR=0.0.0.0:50051
PUBSUB_HTTP_ADDR=0.0.0.0:8080

# memory = self-contained demo; http = invented topics/subscriptions contract
# (docs/relay-native-api.md); relay-events = Relay's real API (see
# docs/RELAY_EVENTS_BACKEND.md) — use this one for the Fasal integration.
RELAY_BACKEND=memory
RELAY_BASE_URL=http://relay:9090
RELAY_AUTH_TOKEN=
RELAY_HTTP_TIMEOUT_SECONDS=15

# Durable local state (topics/subs/actions queue) — enable for production.
PUBSUB_PERSIST=1
PUBSUB_DATA_DIR=/var/lib/relay-pubsub/data

# Only used by RELAY_BACKEND=relay-events
FASAL_GCP_PROJECT=fasal-onprem
FASAL_ACTIONS_TOPIC=farm-actions
FASAL_ACTIONS_SUBSCRIPTION=farm-actions-sub

# Optional compatibility-gateway bearer token. Leave empty for Pub/Sub emulator clients.
RELAY_PUBSUB_AUTH_TOKEN=

# Optional OIDC (JWT via JWKS) — used when RELAY_PUBSUB_AUTH_TOKEN alone is insufficient.
# PUBSUB_OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# PUBSUB_OIDC_AUDIENCE=relay-pubsub
# PUBSUB_OIDC_ISSUER=https://issuer.example.com

# Tenant allowlist (comma-separated projects/…). Empty = all projects.
# PUBSUB_ALLOWED_PROJECTS=projects/fasal-onprem
# PUBSUB_IDENTITY_PROJECT_MAP=user@example.com=projects/fasal-onprem

# Push dispatcher (0 disables)
PUBSUB_PUSH_INTERVAL_SECONDS=2
# PUBSUB_PUSH_TLS_INSECURE=1

RUST_LOG=info
